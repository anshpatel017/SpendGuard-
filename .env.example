# SpendGuard configuration
#
# Copy this file to `.env` in the project root and fill in what you need.
# `.env` is gitignored - never commit real keys.
#
#   cp .env.example .env
#
# Every value here has a working default in backend/src/spendguard/config.py.
# You only need to set the ones you want to change.

# ---------------------------------------------------------------- reproducibility
RANDOM_SEED=42

# --------------------------------------------------------------------- currency
# Decision D-15. Non-INR datasets convert at a rate pinned in their mapping file.
CURRENCY=INR

# ------------------------------------------------------ thresholds (policy-mirrored)
# WARNING: these mirror policy/policy.md. Changing one without changing the
# other will fail tests/test_policy_config_agreement.py, by design.
DIRECT_PURCHASE_CEILING=25000
APPROVAL_THRESHOLD=250000
LIMITED_TENDER_CEILING=2500000
DUPLICATE_AMOUNT_TOLERANCE=0.005
DUPLICATE_DATE_WINDOW_DAYS=14
PREPAYMENT_LOOKBACK_DAYS=90
SPLIT_WINDOW_DAYS=14
NEW_VENDOR_DAYS=90
PRICE_HISTORY_MONTHS=12

# ------------------------------------------------------------------ agent / LLM
# Switch provider with this one line: groq | gemini | ollama (decision D-33).
# Each provider keeps its own key and model below, so switching loses nothing.
LLM_PROVIDER=groq

# Groq: free tier, fast, ~200k tokens/day (~10 investigations).
# Key: https://console.groq.com/keys  ·  models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Gemini: free tier with a larger daily allowance; used for the Phase 9 evaluation.
# Key: https://aistudio.google.com/apikey  ·  your limits: https://aistudio.google.com/rate-limit
# Free-tier prompts may be used by Google to improve its products: synthetic and
# public data only, never an organization's confidential records.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama: fully local, no key, no limit - the "fully local" proof.
# Install Ollama, then:  ollama pull qwen2.5:3b-instruct-q4_K_M
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M

# Optional one-off overrides of whichever provider is active:
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=

LLM_TEMPERATURE=0.1
AGENT_MAX_STEPS=12
# Largest request the agent sends, in input tokens. Groq's free tier refuses
# requests over ~7,000; for Ollama keep it below the model's num_ctx.
AGENT_CONTEXT_TOKENS=5500
VERIFIER_ENABLED=true
# The model judge (semantic check); false saves one call per note but no note is
# then released as verified.
VERIFIER_SEMANTIC_CHECK=true
VERIFIER_MAX_RETRIES=2
INVESTIGATE_TOP_N=50

# ------------------------------------------------------------------------ API
# `spendguard serve`. The Vite dev server (npm run dev in frontend/) proxies /api here.
API_HOST=127.0.0.1
API_PORT=8000

# ------------------------------------------------------------------- databases
# SQLite is the operational store (Decision D-09 fallback: no Docker on this
# machine). Swapping to Postgres is a one-line change here, nothing in code.
# DATABASE_URL=postgresql+psycopg://spendguard:spendguard@localhost:5432/spendguard

# ---------------------------------------------------------------------- runtime
LOG_LEVEL=INFO
