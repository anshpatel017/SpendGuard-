# SpendGuard configuration
#
# Copy this file to `.env` in the project root and fill in what you need.
# `.env` is gitignored - never commit real keys.
#
#   cp .env.example .env
#
# Every value here has a working default in backend/src/spendguard/config.py.
# You only need to set the ones you want to change.

# ---------------------------------------------------------------- reproducibility
RANDOM_SEED=42

# --------------------------------------------------------------------- currency
# Decision D-15. Non-INR datasets convert at a rate pinned in their mapping file.
CURRENCY=INR

# ------------------------------------------------------ thresholds (policy-mirrored)
# WARNING: these mirror policy/policy.md. Changing one without changing the
# other will fail tests/test_policy_config_agreement.py, by design.
DIRECT_PURCHASE_CEILING=25000
APPROVAL_THRESHOLD=250000
LIMITED_TENDER_CEILING=2500000
DUPLICATE_AMOUNT_TOLERANCE=0.005
DUPLICATE_DATE_WINDOW_DAYS=14
PREPAYMENT_LOOKBACK_DAYS=90
SPLIT_WINDOW_DAYS=14
NEW_VENDOR_DAYS=90
PRICE_HISTORY_MONTHS=12

# ------------------------------------------------------------------ agent / LLM
# Development default is Groq: free tier, fast, no GPU needed.
# Get a key at https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# --- Local runtime, for the "fully local" proof (Phase 5+) ---
# Install Ollama, then:  ollama pull qwen2.5:3b-instruct-q4_K_M
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
# LLM_API_KEY=ollama

LLM_TEMPERATURE=0.1
AGENT_MAX_STEPS=12
VERIFIER_MAX_RETRIES=2
INVESTIGATE_TOP_N=50

# ------------------------------------------------------------------- databases
# SQLite is the operational store (Decision D-09 fallback: no Docker on this
# machine). Swapping to Postgres is a one-line change here, nothing in code.
# DATABASE_URL=postgresql+psycopg://spendguard:spendguard@localhost:5432/spendguard

# ---------------------------------------------------------------------- runtime
LOG_LEVEL=INFO
